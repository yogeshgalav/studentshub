{
  "private": true,
  "scripts": {
    "hot": "cross-env NODE_ENV=local  node_modules/webpack/bin/webpack.js --hot --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "build": "cross-env NODE_ENV=local  node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "dev-build": "cross-env NODE_ENV=development  node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod-build": "cross-env NODE_ENV=production  node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "lint": "npm run lint",
    "test:unit": "npm run test:unit",
    "start": "npm run build -- --watch",
    "watch-poll": "npm run build -- --watch-poll"
  },
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@bachdgvn/vue-otp-input": "^1.0.8",
    "@inertiajs/inertia": "^0.10.1",
    "@inertiajs/inertia-vue": "^0.7.2",
    "@johmun/vue-tags-input": "^2.1.0",
    "axios": "^0.18.1",
    "chart.js": "^2.9.4",
    "dayjs": "^1.10.7",
    "dotenv": "^16.0.0",
    "dotenv-webpack": "^7.1.0",
    "ga-gtag": "^1.1.1",
    "ifvisible.js": "^1.0.6",
    "laravel-echo": "^1.11.2",
    "pusher-js": "^4.4.0",
    "quill-image-drop-module": "^1.0.3",
    "quill-image-resize-vue": "^1.0.4",
    "vue-axios": "^2.1.5",
    "vue-chartjs": "^3.5.1",
    "vue-dayjs": "^1.0.2",
    "vue-lazyload": "^1.3.3",
    "vue-loading-overlay": "^3.4.2",
    "vue-phone-number-input": "^1.1.10",
    "vue-social-sharing": "^2.4.7",
    "vue-sweetalert2": "^1.6.4",
    "vue-tel-input": "^5.6.2",
    "vue-upload-component": "^2.8.22",
    "vue2-datepicker": "^3.10.2",
    "vue2-editor": "^2.10.3",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "bootstrap": "^4.6.0",
    "cross-env": "^5.2.1",
    "browser-sync": "^2.27.10",
    "browser-sync-webpack-plugin": "^2.0.1",
    "eslint": "^6.0.0",
    "eslint-plugin-vue": "^6.2.2",
    "jquery": "^3.6.0",
    "laravel-mix": "^4.1.4",
    "lodash": "^4.17.20",
    "popper.js": "^1.16.1",
    "pusher-js": "^4.4.0",
    "resolve-url-loader": "^2.3.2",
    "sass": "^1.42.1",
    "sass-loader": "^7.3.1",
    "vue": "^2.6.11",
    "vue-template-compiler": "^2.6.11"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "npm run lint",
      "git add"
    ]
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "not dead",
    "ie 11"
  ]
}
