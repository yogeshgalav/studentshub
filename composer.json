{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-zip": "*",
        "arcanedev/log-viewer": "^8.0",
        "aws/aws-sdk-php": "^3.158",
        "box/spout": "^3.1",
        "doctrine/dbal": "^2.11",
        "drfraker/snipe-migrations": "^1.3",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "giggsey/libphonenumber-for-php": "^8.12",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-user-activity": "^1.0",
        "inertiajs/inertia-laravel": "^0.4.5",
        "laravel-notification-channels/fcm": "~2.0",
        "laravel-notification-channels/pusher-push-notifications": "^2.3",
        "laravel-notification-channels/twilio": "^3.1.0",
        "laravel-notification-channels/webpush": "^5.0",
        "laravel/framework": "^8.19",
        "laravel/horizon": "^5.2",
        "laravel/passport": "^10.1",
        "laravel/tinker": "^2.5",
        "league/flysystem-aws-s3-v3": "^1.0",
        "mariuzzo/laravel-js-localization": "^1.5",
        "morrislaptop/laravel-queue-clear": "^1.2",
        "paquettg/php-html-parser": "^2.2",
        "predis/predis": "^1.1",
        "rairlie/laravel-locking-session": "^1.1",
        "skagarwal/google-places-api": "^1.6",
        "spatie/laravel-sluggable": "^2.6",
        "sudiptpa/ipstack": "^1.3",
        "webpatser/laravel-uuid": "^4.0",
        "zachflower/ignorable-observers": "^0.2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "facade/ignition": "^2.5",
        "friendsofphp/php-cs-fixer": "^2.16",
        "fakerphp/faker": "^1.9.1",
        "jasonmccreary/laravel-test-assertions": "^1.0",
        "kitloong/laravel-migrations-generator": "^4.3",
        "laravel/dusk": "^6.8",
        "laravel/sail": "^0.0.9",
        "mockery/mockery": "^1.4.2",
        "mohammedmanssour/form-request-tester": "^1.1",
        "nunomaduro/collision": "^5.0",
        "nunomaduro/larastan": "^0.6.1",
        "phpunit/phpunit": "^9.3.3",
        "slevomat/coding-standard": "^6",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "ext-pcntl": "7.2",
            "ext-posix": "7.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
